---
const { limit } = Astro.props;

const projects = [
    {
        id: "auditoriaportfolio",
        title: "Auditoría de Seguridad Portafolio Anterior",
        category: "AppSec / Pentesting",
        shortDesc: "Auditoría de seguridad de mi portafolio web anterior, identificando vulnerabilidades y aplicando medidas de mitigación.",
        tool: "Kali Linux, nmap, OWASP ZAP",        
        tags: ["OWASP", "Kali Linux", "nmap"]
    }

];

const securityProjects = limit ? projects.slice(0, limit) : projects;
---
<div class="w-full space-y-12">
    <div class="grid gride-cols-1 md:grid-cols-2 gap-8 items-start">
        {securityProjects.map((project) => (
            <a
                href={`/projects/${project.id}`}
                class="group bg-slate-900 rounded-3xl border border-slate-900 overflow-hidden transition-all duration-500 ease-in-out hover:shadow-md hover:border-emerald-500/30 flex flex-col p-8 space-y-6 select-none"
            >
                {/* <div class="aspect-4-3 rounded-2xl  overflow-hidden bg-slate-100 border border-slate-100 relative">
                    <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-50/90 backdrop-blur-sm border border-emerald-200 px-2.5 py-1 rounded-md font-bold">
                        {project.category}
                    </span>
                </div> */}

                
                <div class="flex items-center justify-between gap-4 flex-wrap">
                    <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-emerald-950/30 text-emerald-400 border border-emerald-900/50 uppercase tracking-wider font-bold">
                    {project.category}
                    </span>
                    <span class="text-xs font-mono text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    [ VER_PROYECTO -> ]
                    </span>
                </div>

                <div class="space-y-2">
                    <h3 class="text-2xl font-bold tracking-tight text-white flex justify-between items-center">
                        {project.title}
                        
                    </h3>
                    <p class="text-sm text-slate-500 font-light leading-relaxed">{project.shortDesc}</p>
                </div>

                <div class="flex flex-wrap gap-2 pt-2">
                    {project.tags.map((tag) => (
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-950 text-slate-100 border border-slate-800">
                            {tag}
                        </span>
                    ))}
                </div>

            </a>

        ))
        }
    </div>