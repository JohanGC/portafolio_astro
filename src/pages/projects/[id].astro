---
// src/pages/projects/[id].astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const miSlidePersonalizado = {
  forwards: {
    old: { name: 'astroSlideToLeft', duration: '500ms', easing: 'ease-out' },
    new: { name: 'astroSlideFromRight', duration: '500ms', easing: 'ease-out' }
  },
  backwards: {
    old: { name: 'astroSlideToRight', duration: '500ms', easing: 'ease-out' },
    new: { name: 'astroSlideFromLeft', duration: '500ms', easing: 'ease-out' }
  }
};

export function getStaticPaths() {
  return [
    // ==========================================
    // PROYECTOS DE DISEÑO Y PREPRENSA (LIGHT MODE)
    // ==========================================
    { 
      params: { id: 'cadena' },
      props: {
        type: 'design',
        title: "Cadena S.A.",
        category: "Preprensa & Diseño Gráfico",
        fullDesc: "Los diseños expuestos a continuación en este portafolio fueron realizados bajo contrato laboral con la empresa Cadena S.A.",
        challenge: "Se requería diseñar piezas impresas y digitales que cumplieran con los estándares de calidad y las necesidades del cliente acorde a sus procesos de comunicación a través de diversos canales de comunicación.",
        solution: "Se diseñaron piezas que reflejaban la identidad de la marca y cumplían con los requisitos del cliente, además de las necesidades técnicas a nivel productivo como las coberturas de tinta y la distribución automática de gráficos visuales masivos.",
        imgppl: "/images/cadena_0.png",
        processImages2: [
          "/images/cuponera1_1_.png",
          "/images/cuponera1_2_.png",
          "/images/cuponera_2_.png",
          "/images/cuponera_3_.png",
          "/images/cuponera_4_1_.png",
          "/images/cuponera_4_2_.png",
          "/images/factura_nav_1_1_.png",
          "/images/factura_nav_1_2_.png",
          "/images/factura_nav_2_1_.png",
          "/images/factura_nav_2_2_.png",
          "/images/factura_nav_3_1_.png",
          "/images/factura_nav_3_2_.png",
          "/images/rci_1.gif",
          "/images/rci_2.gif"
        ]
      }
    },
    { 
      params: { id: 'asaki' },
      props: {
        type: 'design',
        title: "Diseño de Marca ASAKI-FIT",
        category: "Diseño Gráfico",
        fullDesc: "Desarrollo de un ecosistema de formularios inteligentes en Adobe Acrobat que automatizan el cálculo de tintas y marcas de corte, reduciendo el error humano en un 40%.",
        challenge: "Los operarios de producción perdían valioso tiempo de máquina configurando manualmente especificaciones mecánicas propensas a errores.",
        solution: "Implementación de lógica condicional incrustada y scripts en PDF para ocultar pares directos de control redundantes y asegurar un estándar de salida exacto.",
        imgppl: "/images/Asaki-Fit_7.png",
        processImages: [
          "/images/Asaki-Fit_2.png",
          "/images/Asaki-Fit_3.png",
          "/images/Asaki-Fit_5.png",
          "/images/Asaki-Fit_6.png",
        ]
      }
    },
    { 
      params: { id: 'iamsterdam' },
      props: {
        type: 'design',
        title: "Diseño de Marca I Amsterdam",
        category: "Diseño Gráfico",
        fullDesc: "Diseño de logo para marca dedicada a fumadores en la ciudad de Medellín.",
        challenge: "Se requiere una marca que refleje la identidad de la ciudad y resalte la calidad del producto.",
        solution: "Se toma la idea del cliente para plasmar su logo de manera ilustrada adaptada a un público juvenil en la ciudad.",
        imgppl: "/images/IAmsterdam_4.png",
        processImages: [
          "/images/IAmsterdam_0__.png",
          "/images/IAmsterdam_1__.png",
          "/images/IAmsterdam_2__.png",
          "/images/IAmsterdam_3.png",
        ]
      }
    },
    { 
      params: { id: 'otros-logos' },
      props: {
        type: 'design',
        title: "Logos Ilustrados",
        category: "Diseño Gráfico",
        fullDesc: "Diseño de logos para diversas marcas y grupos sin ánimo de lucro.",
        challenge: "En el transcurso de mi profesión han resultado algunas solicitudes de privados en plasmar mis habilidades como ilustrador en diversas piezas.",
        solution: "Como resultado, se han construido algunas propuestas interesantes en las que los usuarios se han sentido identificados con el resultado esperado, logrando reflejar el arte callejero y las tendencias urbanas en cada una de estas piezas.",
        imgppl: "/images/Rabbit_0.png",
        processImages: [
          "/images/MachadoIndigente_3.png",
          "/images/MachadoIndigente_4.png",
          "/images/Onca_0.png",
          "/images/Onca_1.png",
          "/images/Rabbit_3.png",
          "/images/Rabbit_4.png"
        ]
      }
    },
    { 
      params: { id: 'web' },
      props: {
        type: 'design',
        title: "Construcción de Página Web X",
        category: "Bitácora / Desarrollo Web",
        fullDesc: "Maquetación de portafolio avanzado utilizando componentes limpios y transiciones fluidas de interfaz.",
        challenge: "Se requería un diseño scannable y modular sin sacrificar los tiempos de carga en dispositivos móviles.",
        solution: "Configuración de enrutamiento dinámico en Astro controlando de manera nativa los estados de las vistas.",
        imgppl: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80",
        processImages: [],
        processImages2: []
      }
    },

    // ==========================================
    // PROYECTOS DE CIBERSEGURIDAD (DARK MODE)
    // ==========================================
    {
      params: { id: 'recon-externo-web' },
      props: {
        type: 'security',
        title: "Auditoría de Reconocimiento Externo (Black-Box)",
        category: "Network Security / Pentesting",
        fullDesc: "Auditoría de caja negra sobre un dominio web productivo protegido por CDN/WAF. Se realizó reconocimiento externo completo: recolección de información pública, enumeración DNS, escaneo de puertos, fingerprinting de tecnologías web y evaluación de la configuración TLS, con el fin de mapear la superficie de ataque expuesta a Internet.",
        challenge: "Evaluar qué información y servicios son visibles públicamente para un atacante externo, sin realizar explotación activa ni afectar la disponibilidad del servicio, y determinar si la infraestructura detrás del proxy/CDN estaba adecuadamente protegida.",
        solution: "Ejecución de una batería de herramientas de reconocimiento (WHOIS, DNS, escaneo de puertos, análisis de cabeceras y de la configuración TLS), clasificación de hallazgos por severidad e impacto, y elaboración de un informe con recomendaciones priorizadas: deshabilitar protocolos TLS obsoletos, incorporar cabeceras de seguridad HTTP faltantes y restringir el acceso a puertos administrativos no necesarios públicamente.",
        scope: "Prueba de reconocimiento externo autorizada, sin explotación activa ni pruebas de intrusión. Los hallazgos corresponden a un momento puntual del análisis y no representan necesariamente el estado actual del objetivo. Datos identificativos anonimizados por confidencialidad.",
        methodology: [
          "OSINT / WHOIS",
          "Enumeración DNS",
          "Escaneo de puertos",
          "Fingerprinting web",
          "Evaluación TLS/SSL"
        ],
        tools: ["Kali Linux", "nmap", "nikto", "testssl.sh", "dnsrecon", "gobuster", "whatweb"],
        vulnerabilities: [
          { text: "Inconsistencias de disponibilidad del origen detectadas durante la ventana de pruebas", severity: "high" },
          { text: "Soporte activo de protocolos TLS obsoletos (TLS 1.0/1.1) junto a versiones seguras", severity: "medium" },
          { text: "Ausencia de cabeceras de seguridad HTTP recomendadas (CSP, HSTS, X-Content-Type-Options)", severity: "medium" },
          { text: "Puertos administrativos de panel de hosting expuestos innecesariamente a Internet", severity: "medium" },
          { text: "SSH y base de datos correctamente filtrados ante el escaneo externo", severity: "positive" }
        ],
        reportUrl: "/docs/informe-recon-externo-web.pdf",
        processImages: []
      }
    },
  ];
}

const { 
  type = 'design', 
  title, 
  category, 
  fullDesc, 
  challenge, 
  solution,
  scope,
  methodology = [],
  tools = [],
  vulnerabilities = [],
  reportUrl,
  processImages = [], 
  processImages2 = [], 
  imgppl 
} = Astro.props;

// Variables de Estilo Dinámicas según el tipo de proyecto
const isSecurity = type === 'security';

const styles = {
  bgOuter: isSecurity ? 'bg-slate-950' : 'bg-slate-50/50',
  cardBg: isSecurity ? 'bg-slate-900 border-slate-800 text-slate-100' : 'bg-white border-slate-200/80 text-slate-900',
  categoryTag: isSecurity ? 'text-emerald-400 bg-emerald-950/40 border-emerald-900/60' : 'text-indigo-600 bg-indigo-50 border-indigo-100',
  closeBtn: isSecurity ? 'text-slate-400 hover:text-white bg-slate-950 hover:bg-slate-800 border-slate-800' : 'text-slate-400 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 border-slate-200/60',
  descText: isSecurity ? 'text-slate-300' : 'text-slate-600',
  challengeBox: isSecurity ? 'bg-slate-950/60 border-slate-800/80' : 'bg-slate-50/50 border-slate-100',
  challengeTitle: isSecurity ? 'text-slate-400' : 'text-slate-400',
  solutionBox: isSecurity ? 'bg-emerald-950/20 border-emerald-900/40' : 'bg-indigo-50/30 border-indigo-50/80',
  solutionTitle: isSecurity ? 'text-emerald-400' : 'text-indigo-500',
  borderDivider: isSecurity ? 'border-slate-800' : 'border-slate-100',
};

// Normaliza vulnerabilidades: admite string[] (formato antiguo) u objetos {text, severity}
const normalizedVulns = vulnerabilities.map((v) =>
  typeof v === 'string' ? { text: v, severity: 'info' } : v
);

// Estilos y etiquetas por nivel de severidad
type SeverityKey = 'high' | 'medium' | 'low' | 'info' | 'positive';
type SeverityStyle = { label: string; dot: string; badge: string };

const severityMeta: Record<SeverityKey, SeverityStyle> = {
  high:     { label: 'ALTO',   dot: 'text-red-400',     badge: 'bg-red-950/40 text-red-400 border-red-900/60' },
  medium:   { label: 'MEDIO',  dot: 'text-amber-400',   badge: 'bg-amber-950/30 text-amber-400 border-amber-900/50' },
  low:      { label: 'BAJO',   dot: 'text-blue-400',    badge: 'bg-blue-950/30 text-blue-400 border-blue-900/50' },
  info:     { label: 'INFO',   dot: 'text-slate-400',   badge: 'bg-slate-900 text-slate-400 border-slate-800' },
  positive: { label: 'OK',     dot: 'text-emerald-400', badge: 'bg-emerald-950/30 text-emerald-400 border-emerald-900/50' },
};

const defaultSeverity = severityMeta.info;

function getSeverityMeta(sev: string): SeverityStyle {
  return severityMeta[sev as SeverityKey] ?? defaultSeverity;
}

// Métricas rápidas para el encabezado (solo tiene sentido para hallazgos de seguridad)
const severityCounts: Record<string, number> = normalizedVulns.reduce(
  (acc: Record<string, number>, v: { severity: string }) => {
    acc[v.severity] = (acc[v.severity] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>
);
---

<BaseLayout title={title} description={fullDesc}>
  <main data-theme={isSecurity ? "dark" : "light"} class={`min-h-screen w-full ${styles.bgOuter} transition-colors duration-500`}>
    <div 
      transition:animate={miSlidePersonalizado}
      class="w-full min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
    >
      <div class={`max-w-8xl w-full ${styles.cardBg} rounded-4xl border shadow-2xl p-8 md:p-12 space-y-10`}>
        
        <!-- Encabezado con Categoría y Botón de Cierre -->
        <div class={`flex items-center justify-between border-b ${styles.borderDivider} pb-6`}>
          <span class={`text-[11px] font-mono uppercase tracking-widest px-3 py-1 rounded-md border font-bold ${styles.categoryTag}`}>
            // {category}
          </span>
          <button 
            onclick="history.back()" 
            class={`text-xs font-mono font-bold px-4 py-2 rounded-xl border transition-all ${styles.closeBtn}`}
          >
            // CERRAR [X]
          </button>
        </div>

        <!-- Título y Descripción General -->
        <div class="space-y-6">
          <h1 class="text-3xl md:text-5xl font-black tracking-tight uppercase">
            {title}
          </h1>
          <p class={`text-base font-light leading-relaxed max-w-3xl ${styles.descText}`}>
            {fullDesc}
          </p>

          <!-- Métricas rápidas de hallazgos (solo seguridad) -->
          {isSecurity && normalizedVulns.length > 0 && (
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-md border border-slate-800 bg-slate-950 text-slate-300 font-bold">
                {normalizedVulns.length} HALLAZGOS
              </span>
              {Object.entries(severityCounts).map(([sev, count]) => (
                <span class={`text-[10px] font-mono px-2.5 py-1 rounded-md border font-bold ${getSeverityMeta(sev).badge}`}>
                  {count} {getSeverityMeta(sev).label}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Alcance y limitaciones (Específico de Seguridad) -->
        {scope && (
          <div class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">// ALCANCE_Y_LIMITACIONES</h3>
            <p class="text-xs font-light leading-relaxed text-slate-400">{scope}</p>
          </div>
        )}

        <!-- Línea de tiempo de metodología (Específico de Seguridad) -->
        {methodology.length > 0 && (
          <div class="space-y-3 pt-2">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400">// METODOLOGÍA</h3>
            <div class="flex flex-wrap items-center gap-2">
              {methodology.map((step, idx) => (
                <>
                  <div class="flex items-center gap-2 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2">
                    <span class="text-emerald-400 font-mono text-[10px] font-bold">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="font-mono text-[11px] text-slate-300 font-semibold">{step}</span>
                  </div>
                  {idx < methodology.length - 1 && (
                    <span class="text-slate-700 font-mono text-xs">→</span>
                  )}
                </>
              ))}
            </div>
          </div>
        )}

        <!-- Bloque de Herramientas / Tools (Específico para Seguridad) -->
        {tools.length > 0 && (
          <div class="space-y-3 pt-2">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400">// STACK_&_HERRAMIENTAS</h3>
            <div class="flex flex-wrap gap-2">
              {tools.map((tool) => (
                <span class="text-xs font-mono px-3 py-1 rounded-lg bg-slate-950 text-emerald-400 border border-emerald-900/50 font-semibold">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Tarjetas de Desafío y Resolución -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-2">
          {challenge && (
            <div class={`space-y-3 p-6 rounded-2xl border ${styles.challengeBox}`}>
              <h3 class={`font-mono text-xs font-bold uppercase tracking-wider ${styles.challengeTitle}`}>
                // {isSecurity ? 'OBJETIVO_Y_SUPERFICIE_DE_ATAQUE' : 'EL DESAFÍO'}
              </h3>
              <p class={`text-sm font-light leading-relaxed ${styles.descText}`}>{challenge}</p>
            </div>
          )}
          
          {solution && (
            <div class={`space-y-3 p-6 rounded-2xl border ${styles.solutionBox}`}>
              <h3 class={`font-mono text-xs font-bold uppercase tracking-wider ${styles.solutionTitle}`}>
                // {isSecurity ? 'MITIGACIÓN_Y_REMEDIACIÓN' : 'RESOLUCIÓN APLICADA'}
              </h3>
              <p class={`text-sm font-light leading-relaxed ${styles.descText}`}>{solution}</p>
            </div>
          )}
        </div>

        <!-- Hallazgos / Vulnerabilidades con severidad (Específico de Seguridad) -->
        {normalizedVulns.length > 0 && (
          <div class={`space-y-4 pt-6 border-t ${styles.borderDivider}`}>
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-400">// HALLAZGOS_EVALUADOS</h3>
            <ul class="space-y-2 font-mono text-xs text-slate-300">
              {normalizedVulns.map((vuln) => {
                const meta = getSeverityMeta(vuln.severity);
                return (
                  <li class="flex items-start gap-3 bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                    <span class={`shrink-0 text-[9px] font-bold px-2 py-0.5 rounded border ${meta.badge}`}>
                      {meta.label}
                    </span>
                    <span>{vuln.text}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <!-- Enlace a informe descargable (Específico de Seguridad) -->
        {reportUrl && (
          <div class="pt-2">
            <a 
              href={reportUrl} 
              download
              class="inline-flex items-center gap-2 text-xs font-mono font-bold px-4 py-2.5 rounded-xl border border-emerald-900/60 bg-emerald-950/30 text-emerald-400 hover:bg-emerald-950/50 transition-all"
            >
              // DESCARGAR_INFORME_COMPLETO (PDF) ↓
            </a>
          </div>
        )}

        <!-- Imagen principal (Opcional) -->
        {imgppl && (
          <div class="grid grid-cols-1 gap-6 pt-2">
            <img 
              src={imgppl} 
              alt={`Imagen destacada del proyecto ${title}`} 
              class="w-full h-auto object-cover rounded-2xl border border-slate-800 shadow-md" 
            />
          </div>
        )}

        <!-- Galería de evidencias 1 -->
        {processImages && processImages.length > 0 && (
          <div class={`space-y-4 pt-6 border-t ${styles.borderDivider}`}>
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 text-center">
              EVIDENCIAS TÉCNICAS DEL PROCESO
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
              {processImages.map((img, idx) => (
                <div class="group space-y-2">
                  <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 shadow-sm transition-transform duration-500 group-hover:scale-[1.01]">
                    <img 
                      src={img} 
                      alt={`Validación Estructural ${idx + 1}`} 
                      class="w-full h-auto object-cover aspect-4/3"
                      loading="lazy" 
                    />
                  </div>
                  <span class="text-[10px] font-mono text-slate-400 block text-center">
                    Fase de Validación Estructural {idx + 1}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Galería de evidencias 2 -->
        {processImages2 && processImages2.length > 0 && (
          <div class={`space-y-4 pt-6 border-t ${styles.borderDivider}`}>
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 text-center">
              PIEZAS FINALIZADAS Y REGISTROS
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
              {processImages2.map((img, idx) => (
                <div class="group space-y-2">
                  <div class="overflow-hidden bg-transparent transition-transform duration-500 group-hover:scale-[1.01]">
                    <img 
                      src={img} 
                      alt={`Muestra ${idx + 1}`} 
                      class="m-auto w-auto h-auto object-cover rounded-xl"
                      loading="lazy" 
                    />
                  </div>
                  <span class="text-[10px] font-mono text-slate-400 block text-center">
                    Pieza / Registro {idx + 1}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </main>
</BaseLayout>